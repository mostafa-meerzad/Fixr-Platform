# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fixr_db"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3001
ALLOWED_ORIGINS="http://localhost:3000"

# Development OTP bypass — code here is accepted when NODE_ENV != production,
# regardless of which OTP_PROVIDER is active.
DEV_OTP_CODE=000000

# OTP provider: "telegram" (default) | "whatsapp"
# See apps/backend/README.md for switching instructions.
OTP_PROVIDER=telegram

# Telegram Gateway OTP — required when OTP_PROVIDER=telegram in production.
# Obtain a token at https://gateway.telegram.org/account/api
TELEGRAM_GATEWAY_TOKEN=""

# WhatsApp OTP (WhatsApp Business API) — required when OTP_PROVIDER=whatsapp in production.
# Provider is implemented and ready; requires Meta business verification + an approved
# authentication template before it can send real messages.
# See apps/backend/README.md for re-enable instructions.
WHATSAPP_API_URL="https://graph.facebook.com/v25.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Firebase (FCM)
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Stream Chat
STREAM_API_KEY=""
STREAM_API_SECRET=""
