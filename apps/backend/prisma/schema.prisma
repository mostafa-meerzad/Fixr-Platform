generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  phone            String            @unique
  name             String
  role             UserRole
  avatarUrl        String?
  fcmToken         String?
  language         String            @default("fa")
  isActive         Boolean           @default(true)
  isSuspended      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  adminProfile     AdminProfile?
  disputes         Dispute[]         @relation("DisputeReporter")
  expertProfile    ExpertProfile?
  homeownerProfile HomeownerProfile?
  jobsAsHomeowner  Job[]             @relation("HomeownerJobs")
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  reviewsReceived  Review[]          @relation("ReviewsReceived")
  reviewsGiven     Review[]          @relation("ReviewsGiven")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model HomeownerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  zoneId         String?
  address        String?
  positivePoints Int      @default(0)
  negativePoints Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone           Zone?    @relation("HomeownerZone", fields: [zoneId], references: [id])

  @@map("homeowner_profiles")
}

model ExpertProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  selfieUrl          String?
  tazkiraFrontUrl    String?
  tazkiraBackUrl     String?
  shopName           String?
  shopImageUrl       String?
  workLicenseUrl     String?
  description        String?
  verificationStatus VerificationStatus  @default(PENDING)
  verificationNote   String?
  isAvailable        Boolean             @default(true)
  rating             Float               @default(0)
  completedJobs      Int                 @default(0)
  totalJobs          Int                 @default(0)
  completionRate     Float               @default(0)
  noShowCount        Int                 @default(0)
  positivePoints     Int                 @default(0)
  negativePoints     Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  shopAddress        String?
  shopZoneId         String?
  bids               Bid[]
  creditBalance      CreditBalance?
  creditTransactions CreditTransaction[]
  serviceCategories  ExpertCategory[]
  shopZone           Zone?               @relation("ExpertShopZone", fields: [shopZoneId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceZones       ExpertZone[]

  @@map("expert_profiles")
}

model Zone {
  id                 String             @id @default(cuid())
  name               String             @unique
  nameEn             String?
  latitude           Float?
  longitude          Float?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  expertShopProfiles ExpertProfile[]    @relation("ExpertShopZone")
  experts            ExpertZone[]
  homeownerProfiles  HomeownerProfile[] @relation("HomeownerZone")
  jobs               Job[]

  @@map("zones")
}

model ExpertZone {
  expertId String
  zoneId   String
  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  zone     Zone          @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([expertId, zoneId])
  @@map("expert_zones")
}

model ExpertCategory {
  expertId   String
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  expert     ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@id([expertId, categoryId])
  @@map("expert_categories")
}

model Category {
  id        String           @id @default(cuid())
  name      String           @unique
  nameEn    String?
  icon      String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  experts   ExpertCategory[]
  jobs      Job[]

  @@map("categories")
}

model Job {
  id                    String     @id @default(cuid())
  title                 String
  description           String
  address               String
  notes                 String?
  status                JobStatus  @default(DRAFT)
  urgency               Urgency
  scheduledAt           DateTime?
  homeownerId           String
  categoryId            String
  zoneId                String
  latitude              Float?
  longitude             Float?
  acceptedBidId         String?    @unique
  openedAt              DateTime?
  assignedAt            DateTime?
  expertEnRouteAt       DateTime?
  expertArrivedAt       DateTime?
  inProgressAt          DateTime?
  completionRequestedAt DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  bids                  Bid[]
  dispute               Dispute?
  media                 JobMedia[]
  acceptedBid           Bid?       @relation("AcceptedBid", fields: [acceptedBidId], references: [id])
  category              Category   @relation(fields: [categoryId], references: [id])
  homeowner             User       @relation("HomeownerJobs", fields: [homeownerId], references: [id])
  zone                  Zone       @relation(fields: [zoneId], references: [id])
  review                Review?

  @@map("jobs")
}

model JobMedia {
  id        String   @id @default(cuid())
  jobId     String
  url       String
  type      String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_media")
}

model Bid {
  id                      String        @id @default(cuid())
  jobId                   String
  expertId                String
  price                   Int
  estimatedArrivalMinutes Int
  estimatedDurationHours  Float
  warrantyDescription     String?
  expertMessage           String?
  isWithdrawn             Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  expert                  ExpertProfile @relation(fields: [expertId], references: [id])
  job                     Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  acceptedForJob          Job?          @relation("AcceptedBid")

  @@unique([jobId, expertId])
  @@map("bids")
}

model CreditBalance {
  id        String        @id @default(cuid())
  expertId  String        @unique
  balance   Int           @default(0)
  updatedAt DateTime      @updatedAt
  expert    ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@map("credit_balances")
}

model CreditTransaction {
  id           String                @id @default(cuid())
  expertId     String
  type         CreditTransactionType
  amount       Int
  balanceAfter Int
  description  String
  expiresAt    DateTime?
  createdAt    DateTime              @default(now())
  expert       ExpertProfile         @relation(fields: [expertId], references: [id])

  @@map("credit_transactions")
}

model CreditRate {
  id                String   @id @default(cuid())
  afnPerCredit      Int
  welcomeCredits    Int      @default(5)
  welcomeExpiryDays Int      @default(30)
  updatedAt         DateTime @updatedAt
  updatedBy         String?

  @@map("credit_rates")
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  title   String
  titleEn String?
  body    String
  bodyEn  String?
  data    Json?
  isRead  Boolean          @default(false)
  sentAt  DateTime         @default(now())
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Review {
  id         String   @id @default(cuid())
  jobId      String   @unique
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  isPositive Boolean?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  tags       String[]
  job        Job      @relation(fields: [jobId], references: [id])
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])

  @@map("reviews")
}

model Dispute {
  id          String        @id @default(cuid())
  jobId       String        @unique
  reporterId  String
  reason      DisputeReason
  description String
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  job         Job           @relation(fields: [jobId], references: [id])
  reporter    User          @relation("DisputeReporter", fields: [reporterId], references: [id])

  @@map("disputes")
}

model OtpSession {
  id                String   @id @default(cuid())
  phone             String
  /// Null for Telegram sessions (code is generated and held by Telegram).
  code              String?
  /// Telegram: Telegram request_id from sendVerificationMessage.
  /// WhatsApp: the locally generated OTP code (used as the verify key).
  /// Legacy rows (pre-migration): null — OtpService falls back to code column.
  providerRequestId String?
  attempts          Int      @default(0)
  verified          Boolean  @default(false)
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([phone])
  @@map("otp_sessions")
}

enum UserRole {
  HOMEOWNER
  EXPERT
  ADMIN
}

enum JobStatus {
  DRAFT
  OPEN
  ASSIGNED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETION_REQUESTED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum Urgency {
  EMERGENCY
  TODAY
  SCHEDULED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DisputeReason {
  PRICE_DISPUTE
  WORK_QUALITY
  NO_SHOW
  COMMUNICATION_ISSUE
  OTHER
}

enum CreditTransactionType {
  WELCOME_GRANT
  PURCHASE
  BID_SPEND
  BID_REFUND
  ADMIN_ADJUSTMENT
}

enum NotificationType {
  JOB_POSTED
  BID_RECEIVED
  BID_ACCEPTED
  BID_WITHDRAWN
  NEW_MESSAGE
  EXPERT_EN_ROUTE
  EXPERT_ARRIVED
  COMPLETION_REQUESTED
  JOB_COMPLETED
  JOB_CANCELLED
  REVIEW_REQUESTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
}
