{
  "name": "fixr-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "backend": "turbo dev --filter=@fixr/backend",
    "admin": "turbo dev --filter=@fixr/admin",
    "mobile": "turbo dev --filter=@fixr/mobile",
    "postinstall": "bunx patch-package || echo 'Skipping patches (package not found)'"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "patch-package": "^8.0.0",
    "@stream-io/flat-list-mvcp": "0.10.3"
  }
}
